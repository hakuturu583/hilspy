        <fx:PROTOCOL>LIN</fx:PROTOCOL>
        <fx:PROTOCOL-VERSION>2.1</fx:PROTOCOL-VERSION>
        <fx:CHANNEL-REFS>
          <fx:CHANNEL-REF ID-REF="CH_LIN"/>
        </fx:CHANNEL-REFS>
        <fx:MEDIUM>ELECTRICAL</fx:MEDIUM>
      </fx:CLUSTER>
      <fx:CLUSTER ID="CL_FR" xsi:type="flexray:CLUSTER-TYPE">
        <ho:SHORT-NAME>ChassisFlexRay</ho:SHORT-NAME>
        <fx:SPEED>10000000</fx:SPEED>
        <fx:IS-HIGH-LOW-BIT-ORDER>true</fx:IS-HIGH-LOW-BIT-ORDER>

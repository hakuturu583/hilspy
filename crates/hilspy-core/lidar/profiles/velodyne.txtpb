# Velodyne LiDAR profiles (schema: ../lidar_profile.proto).
#
# Channel angles and firing offsets are derived from tier4/nebula
# (https://github.com/tier4/nebula, Apache-2.0): its calibration files and
# packet definitions. They are nominal values; a real sensor's own
# calibration differs slightly.
#
# Regenerate the embedded binary after editing:
#   cargo run -p hilspy-core --example lidar_profiles

profiles {
  name: "vlp16"
  vendor: "Velodyne"
  model: "VLP-16"
  aliases: "puck"
  layout {
    packet_size: 1206
    constants { offset: 1205 value: "\x22" }
    blocks_offset: 0
    block_count: 12
    block_size: 100
    block_flags: 0xEEFF
    azimuth_offset: 2
    azimuth_scale: 100
    units_offset: 4
    unit_size: 3
    units_per_block: 32
    blocks_per_firing: 1
    firings_per_block: 2
    distance_unit: 0.002
    return_mode_offset: 1204
    timestamp { kind: TOP_OF_HOUR micros_offset: 1200 }
  }
  channels { elevation: -15 }
  channels { elevation: 1 firing_offset_ns: 2304 }
  channels { elevation: -13 firing_offset_ns: 4608 }
  channels { elevation: 3 firing_offset_ns: 6912 }
  channels { elevation: -11 firing_offset_ns: 9216 }
  channels { elevation: 5 firing_offset_ns: 11520 }

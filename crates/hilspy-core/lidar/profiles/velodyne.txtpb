  channels { elevation: 13 firing_offset_ns: 29952 }
  channels { elevation: -1 firing_offset_ns: 32256 }
  channels { elevation: 15 firing_offset_ns: 34560 }
  return_modes { code: 0x37 name: "strongest" returns: "strongest" }
  return_modes { code: 0x38 name: "last" returns: "last" }
  return_modes { code: 0x39 name: "last_strongest" returns: "last" returns: "strongest" }
  timing { firing_period_ns: 55296 offset_ns: 0 }
  min_range: 0.4
  max_range: 100
  rpm: 600
  port: 2368
}


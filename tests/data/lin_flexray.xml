<?xml version="1.0" encoding="UTF-8"?>
<!-- Test network for the fibex codec's LIN and FlexRay channels.
     LIN (protocol 2.1, so enhanced checksums unless a triggering says
     otherwise): LightCmd 0x10 (enhanced), LightStatus 0x11 (CHECKSUM-TYPE
     CLASSIC), MasterReq 0x3C (diagnostic: always classic). Schedule tables:
     Normal = LightCmd 10 ms, LightStatus 20 ms, LightCmd 10 ms (period 40 ms,
     so LightCmd every 20 ms, LightStatus every 40 ms); Diagnostic =
     MasterReq 10 ms, a free-format entry 10 ms (period 20 ms).
     FlexRay (cycle 5000 us): channel A carries BrakeFr (slot 3, every
     cycle), YawFr (slot 7, base cycle 1, repetition 4) and DiagFr (slot 7,
     base cycle 3, repetition 4: slot multiplexing; 3 bytes, padded to 4);
     channel B BrakeFr only. -->
<fx:FIBEX xmlns:fx="http://www.asam.net/xml/fbx" xmlns:ho="http://www.asam.net/xml" xmlns:lin="http://www.asam.net/xml/fbx/lin" xmlns:flexray="http://www.asam.net/xml/fbx/flexray" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" VERSION="4.1.2">

"""Type stubs of the hilspy._hilspy extension module (Rust, PyO3)."""

import sys
from array import array
from collections.abc import Callable, Iterable, Iterator, Mapping, Sequence
from types import TracebackType
from typing import Any, Literal, Protocol, TypeAlias

if sys.version_info >= (3, 11):
    from typing import Self
else:
    from typing_extensions import Self
if sys.version_info >= (3, 12):
    from collections.abc import Buffer
else:
    from typing_extensions import Buffer

__version__: str

class Error(Exception): ...

#: A field value: decoded values, and what ``send`` accepts. Numeric arrays
#: decode as ``array.array`` (``send`` also takes lists, tuples and numpy
#: arrays of numbers); other sequences (satellite records, ...) as lists.
Value: TypeAlias = None | bool | int | float | str | Mapping[str, Any] | array[Any] | Sequence[Any]

#: Which way of a link ``Channel.disconnect`` cuts.
Direction: TypeAlias = Literal["send", "recv", "both"]

class _ToBytes(Protocol):
    # numpy arrays and array.array before Python 3.12, whose stubs are not Buffer.
    def tobytes(self) -> bytes: ...

#: ``data``: bytes, a bytearray, or a uint8 numpy array / memoryview /
#: ``array.array("B")`` of any shape (its bytes in C order: an image's
#: pixels), or a sequence of ints.
BytesLike: TypeAlias = Buffer | _ToBytes | Sequence[int]

class Message:
    def __init__(
        self,
        name: str | None = None,
        fields: Mapping[str, Value] | None = None,
        *,
        data: BytesLike | None = None,
        id: int | None = None,
        bus: str | None = None,
        extended: bool | None = None,
        fd: bool = False,
        enhanced: bool | None = None,
        checksum: int | None = None,
        cycle: int | None = None,
        channel: str | None = None,
    ) -> None: ...
    @property
    def name(self) -> str | None: ...
    @property
    def fields(self) -> dict[str, Any]: ...
    @property
    def data(self) -> bytes | None: ...
    @property
    def bus(self) -> str | None: ...
    @property
    def id(self) -> int | None: ...
    @property
    def extended(self) -> bool: ...
    @property
    def fd(self) -> bool: ...
    @property
    def enhanced(self) -> bool: ...
    @property
    def checksum(self) -> int | None: ...
    @property
    def cycle(self) -> int | None: ...
    @property
    def channel(self) -> str | None: ...
    @property
    def timestamp(self) -> float | None: ...
    def __getitem__(self, key: str) -> Any: ...
    def __contains__(self, key: str) -> bool: ...
    def __eq__(self, other: object) -> bool: ...

class Periodic:
    def update(self, message: Message | str, fields: Mapping[str, Value] | None = None) -> None: ...
    def stop(self) -> None: ...
    @property
    def period(self) -> float: ...
    @period.setter
    def period(self, value: float) -> None: ...
    @property
    def sent_count(self) -> int: ...
    @property
    def last_error(self) -> str | None: ...
    @property
    def running(self) -> bool: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> bool: ...

class _Subscription:
    def stop(self) -> None: ...
    @property
    def running(self) -> bool: ...

class _Channel:
    def send(self, message: Message | str, fields: Mapping[str, Value] | None = None) -> None: ...
    def recv(self, timeout: float | None = None) -> Message | None: ...
    def every(
        self,
        period: float | None,
        message: Message | str,
        fields: Mapping[str, Value] | None = None,
        *,
        duration: float | None = None,
    ) -> Periodic: ...
    def subscribe(
        self, callback: Callable[[Message | BaseException | None], object]
    ) -> _Subscription: ...
    def disconnect(
        self,
        duration: float | None = None,
        *,
        direction: Direction = "both",
        messages: str | Iterable[str] | None = None,
    ) -> None: ...
    def reconnect(self, *, direction: Direction = "both") -> None: ...
    def disconnected(self, direction: Direction = "both") -> bool: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    def __iter__(self) -> Iterator[Message]: ...
    def __next__(self) -> Message: ...

def _open(
    url: str, codec: str = "raw", *, clock: Clock | None = None, **options: Value
) -> _Channel: ...
def _shutdown_telemetry() -> None: ...

class Clock:
    """Simulated time; channels opened with ``clock=`` run on it."""

    def __init__(self, start: float = 0.0) -> None: ...
    @property
    def now(self) -> float: ...
    @property
    def next_due(self) -> float | None: ...
    def advance(self, dt: float) -> None: ...
    def advance_to(self, t: float) -> None: ...

class TransportPlugin(Protocol):
    def send(self, packet: Message, /) -> None: ...
    def recv(self, timeout: float | None, /) -> Message | None: ...

class CodecPlugin(Protocol):
    def encode(self, message: Message, /) -> Message | Iterable[Message] | None: ...
    def decode(self, packet: Message, /) -> Message | Iterable[Message] | None: ...

def register_transport(
    scheme: str, factory: Callable[[str, dict[str, str]], TransportPlugin]
) -> None: ...
def register_codec(
    name: str, factory: Callable[[str | None, dict[str, Any]], CodecPlugin]
) -> None: ...
